<!--  Services Hero  -->
<section class="services-hero">
  <div class="hero-inner center">
    <h3>Discover Professional Services</h3>
    <p class="muted">
      Find the perfect freelancer for your project from thousands of skilled
      professionals.
    </p>

   <form class="search-bar" action="/services" method="GET"> 
    <input type="text" name="search" placeholder="Search for services (e.g., web design, copywriting, marketing...)" value="<%= typeof search !== 'undefined' ? search : '' %>" aria-label="Search services by name" /> 
    <button type="submit" class="btn indigo">Search</button> 
    <!-- Add Service button--->
     <a class="btn green add-service-btn" href="services/new" > + Add Service </a> 
    </form>

    <!-- Filter row using Materialize dropdowns -->
<div class="filter-row">
  <!-- Category -->
  <a class="btn dropdown-trigger" href="#!" data-target="dd-category" id="btn-category" aria-expanded="false">
    All Categories ▾
  </a>
  <ul id="dd-category" class="dropdown-content">
    <li><a href="#!" data-filter="category" data-value="">All Categories</a></li>
    <li><a href="#!" data-filter="category" data-value="programming">Programming</a></li>
    <li><a href="#!" data-filter="category" data-value="design">Design</a></li>
    <li><a href="#!" data-filter="category" data-value="business">Business</a></li>
    <li><a href="#!" data-filter="category" data-value="music">Music</a></li>
    <li><a href="#!" data-filter="category" data-value="cooking">Cooking</a></li>
    <li><a href="#!" data-filter="category" data-value="languages">Languages</a></li>
  </ul>

  <!-- Price -->
  <a class="btn dropdown-trigger" href="#!" data-target="dd-price" id="btn-price" aria-expanded="false">
    Price Range ▾
  </a>
  <ul id="dd-price" class="dropdown-content">
    <li><a href="#!" data-filter="price" data-value="">Any</a></li>
    <li><a href="#!" data-filter="price" data-value="under-50">Under $50</a></li>
    <li><a href="#!" data-filter="price" data-value="50-200">$50 – $200</a></li>
    <li><a href="#!" data-filter="price" data-value="200-500">$200 – $500</a></li>
    <li><a href="#!" data-filter="price" data-value="500-plus">$500+</a></li>
  </ul>

  <!-- Delivery -->
  <a class="btn dropdown-trigger" href="#!" data-target="dd-delivery" id="btn-delivery" aria-expanded="false">
    Delivery Time ▾
  </a>
  <ul id="dd-delivery" class="dropdown-content">
    <li><a href="#!" data-filter="delivery" data-value="">Any</a></li>
    <li><a href="#!" data-filter="delivery" data-value="1">1 day</a></li>
    <li><a href="#!" data-filter="delivery" data-value="3">3 days</a></li>
    <li><a href="#!" data-filter="delivery" data-value="7">7 days</a></li>
    <li><a href="#!" data-filter="delivery" data-value="14">2+ weeks</a></li>
  </ul>

  <!-- Sort -->
  <a class="btn dropdown-trigger" href="#!" data-target="dd-sort" id="btn-sort" aria-expanded="false">
    Sort by: Relevance ▾
  </a>
  <ul id="dd-sort" class="dropdown-content">
    <li><a href="#!" data-filter="sort" data-value="relevance">Relevance</a></li>
    <li><a href="#!" data-filter="sort" data-value="price-asc">Price: Low → High</a></li>
    <li><a href="#!" data-filter="sort" data-value="price-desc">Price: High → Low</a></li>
    <li><a href="#!" data-filter="sort" data-value="newest">Newest</a></li>
    <li><a href="#!" data-filter="sort" data-value="top">Top Rated</a></li>
  </ul>
</div>

</section>

<!--  Services Grid  -->
<section class="services-list container">
  <h6 class="muted"><%= services.length %> services available</h6>
  <p class="tiny muted">Showing results for all categories</p>

  <div class="services-grid">
  <% (services || []).forEach(function (s) { %>
    <div class="service-card">
      <!--  Fallback to Pravatar or Unsplash if no s.img -->
      <img
          src="<%= s.img || ('https://placehold.co/600x400?text=' + encodeURIComponent(s.title)) %>"
          alt="<%= s.title %>"
          class="service-img"
        />


      <div class="service-body">
        <h6 class="service-title"><%= s.title %></h6>
        <p class="muted tiny">By <%= s.name %> – <%= s.role %></p>
        <div class="service-footer">
          <span class="price">From <%= s.price %></span>
          <a href="/services/<%= s._id %>" class="btn indigo">VIEW DETAILS</a>
        </div>
      </div>
    </div>
  <% }); %>
</div>

</section>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    // Ensure Materialize JS/CSS is loaded on the page
    // Init all dropdown triggers
    const elems = document.querySelectorAll(".dropdown-trigger");
    M.Dropdown.init(elems, {
      alignment: "left",
      coverTrigger: false,   // show below button, not covering it
      closeOnClick: true,
      constrainWidth: false
    });

    // Helper: update URL param and reload (preserve other params)
    function setParamAndReload(key, value) {
      const url = new URL(window.location.href);
      if (value === "" || value == null) {
        url.searchParams.delete(key);
      } else {
        url.searchParams.set(key, value);
      }
      // Keep search term intact automatically; nothing to do here
      window.location.href = url.toString();
    }

    // Map filter key to button element + label formatter
    const btns = {
      category: document.getElementById("btn-category"),
      price: document.getElementById("btn-price"),
      delivery: document.getElementById("btn-delivery"),
      sort: document.getElementById("btn-sort"),
    };

    function setBtnLabel(filter, text) {
      if (!btns[filter]) return;
      if (filter === "sort") {
        btns[filter].textContent = "Sort by: " + text + " ▾";
      } else {
        btns[filter].textContent = text + " ▾";
      }
    }

    // Handle clicks on all dropdown menus (event delegation on body)
    document.body.addEventListener("click", function (e) {
      const a = e.target.closest(".dropdown-content a[data-filter]");
      if (!a) return;

      const filter = a.getAttribute("data-filter");
      const value = a.getAttribute("data-value") || "";
      const label = a.textContent.trim();

      // Update button label immediately (UI feedback)
      setBtnLabel(filter, label);

      // Update query param and reload
      setParamAndReload(filter, value);
    });

    // Optional: On load, reflect current query values into button labels
    (function reflectFromQuery() {
      const url = new URL(window.location.href);
      const current = {
        category: url.searchParams.get("category"),
        price: url.searchParams.get("price"),
        delivery: url.searchParams.get("delivery"),
        sort: url.searchParams.get("sort")
      };
      // Provide human labels for defaults
      if (!current.category) setBtnLabel("category", "All Categories");
      if (!current.price) setBtnLabel("price", "Price Range");
      if (!current.delivery) setBtnLabel("delivery", "Delivery Time");
      if (!current.sort) setBtnLabel("sort", "Relevance");

      // If there are values, try to find matching menu text and use it
      function labelFromMenu(menuId, val, fallback) {
        const menu = document.getElementById(menuId);
        if (!menu || !val) return fallback;
        const match = menu.querySelector(`a[data-value="${CSS.escape(val)}"]`);
        return match ? match.textContent.trim() : fallback;
      }

      if (current.category) setBtnLabel("category", labelFromMenu("dd-category", current.category, "All Categories"));
      if (current.price)    setBtnLabel("price",    labelFromMenu("dd-price", current.price, "Price Range"));
      if (current.delivery) setBtnLabel("delivery", labelFromMenu("dd-delivery", current.delivery, "Delivery Time"));
      if (current.sort)     setBtnLabel("sort",     labelFromMenu("dd-sort", current.sort, "Relevance"));
    })();
  });
</script>
