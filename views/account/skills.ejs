<% /* views/account/skills.ejs */ %>
<section class="account-wrap">
  <!-- Sidebar -->
  <%- include('../partials/accountSidebar', { 
        active: 'skills', 
        user:   (typeof user  !== 'undefined' ? user  : null), 
        stats:  (typeof stats !== 'undefined' ? stats : null) 
  }) %>

  <!-- Main -->
  <main class="account-main">
    <h4 class="no-margin">My Skills</h4>
    <p class="muted small">Add skills you can offer to earn credits</p>

    <!-- Add Skill Form -->
    <form action="/skills" method="POST" class="card">
      <div class="card-content">
        <div class="row">
          <!-- Title -->
          <div class="input-field col s12 m6">
            <input id="title" name="title" type="text" required />
            <label for="title">Skill Title</label>
          </div>

          <!-- Credits -->
          <div class="input-field col s12 m6">
            <input id="credits" name="credits" type="number" min="1" value="1" />
            <label for="credits">Credits per session</label>
          </div>

          <!-- Description -->
          <div class="input-field col s12">
            <textarea
              id="description"
              name="description"
              class="materialize-textarea"
              rows="3"
            ></textarea>
            <label for="description">Description</label>
          </div>

          <!-- Category Select -->
          <div class="input-field col s12 m6">
            <select id="categorySelect">
              <option value="Programming">Programming</option>
              <option value="Design">Design</option>
              <option value="Business">Business</option>
              <option value="Music">Music</option>
              <option value="Cooking">Cooking</option>
              <option value="Languages">Languages</option>
              <option value="Other">Other</option>
            </select>
            <label for="categorySelect">Category</label>
          </div>

          <!-- Other category field (hidden initially) -->
          <div class="input-field col s12 m6" id="otherField" style="display:none">
            <input type="text" id="categoryOther" placeholder="Type your category" />
            <label for="categoryOther" class="active">Custom category</label>
          </div>

          <!-- Final hidden input -->
          <input type="hidden" name="category" id="categoryFinal" />
        </div>
      </div>

      <div class="card-action right-align">
        <button type="submit" class="btn indigo waves-effect waves-light">
          Add Skill
        </button>
      </div>
    </form>

    <!-- Skills list -->
    <div class="card">
      <div class="card-content">
        <span class="card-title">Your Skills</span>
        <% if ((skills || []).length === 0) { %>
          <p class="muted">No skills yet. Add one above 👆</p>
        <% } %>
        <ul class="collection">
          <% (skills || []).forEach(function(s){ %>
            <li class="collection-item">
              <div class="row" style="margin-bottom:0">
                <div class="col s8">
                  <strong><%= s.title %></strong>
                  <div class="tiny muted"><%= s.category %> • <%= s.credits %> credits</div>
                  <div class="grey-text"><%= s.description %></div>
                </div>
                <div class="col s4 right-align">
                  <a href="/services/<%= s._id %>" class="btn-flat">View</a>
                </div>
              </div>
            </li>
          <% }) %>
        </ul>
      </div>
    </div>
  </main>
</section>

<!-- Page scripts -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // init Materialize selects
    const selects = document.querySelectorAll('select');
    M.FormSelect.init(selects, {});

    const select     = document.getElementById('categorySelect');
    const otherWrap  = document.getElementById('otherField');
    const otherInput = document.getElementById('categoryOther');
    const finalField = document.getElementById('categoryFinal');
    const form       = document.querySelector('form');

    function syncVisibility() {
      if (select.value === 'Other') {
        otherWrap.style.display = 'block';
        otherInput.required = true;
        otherInput.focus();
      } else {
        otherWrap.style.display = 'none';
        otherInput.required = false;
        otherInput.value = '';
      }
    }

    // run once + bind change
    syncVisibility();
    select.addEventListener('change', syncVisibility);

    // set hidden input value on submit
    form.addEventListener('submit', (e) => {
      finalField.value = (select.value === 'Other')
        ? otherInput.value.trim()
        : select.value;

      if (select.value === 'Other' && !finalField.value) {
        e.preventDefault();
        otherInput.focus();
        M.toast && M.toast({html: 'Please type your category'});
      }
    });
  });
</script>
